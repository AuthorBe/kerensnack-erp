{
    "name": "kerensnack/erp",
    "description": "Keren Snack ERP - Enterprise Resource Planning System",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "aws/aws-sdk-php": "^3.395",
        "dompdf/dompdf": "^2.0 || ^3.0",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    }
}
