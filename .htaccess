<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect sensitive files & folders
    RewriteRule ^(\.env|\.git|config|app|views|database|docs|tests) - [F,L,NC]

    # Forward all other traffic to the /public directory
    RewriteRule ^$ public/ [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>
