# ==============================================================================
# KEREN SNACK ERP - Public Directory Security & Routing Configuration
# ==============================================================================

# 1. Matikan Directory Browsing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# 2. Blokir Akses ke Berkas Sensitif/Tersembunyi jika ada dalam public
<IfModule mod_authz_core.c>
    <FilesMatch "(^\..*|\.(md|sql|json|lock|env|log|yml|yaml|ini|sh|bat|cmd|bak|dist|example|config))$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(^\..*|\.(md|sql|json|lock|env|log|yml|yaml|ini|sh|bat|cmd|bak|dist|example|config))$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 3. Routing ke Front Controller
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Send Requests To Front Controller (Router.php handles slashes dynamically)...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
